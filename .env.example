FAL_KEY=
OPENAI_API_KEY=
# Server-only Claude: LLM_API_STYLE=anthropic, LLM_MODEL=claude-haiku-5-5,
# LLM_BASE_URL=https://api.anthropic.com/v1, and LLM_API_KEY (or ANTHROPIC_API_KEY).
# OpenAI-compatible endpoints also support chat_completions or responses styles.
LLM_API_KEY=
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_STYLE=
# Optional model-preview LLM critique; off keeps the photo-to-3D path LLM-free.
ENABLE_MODEL_VISUAL_CRITIQUE=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=makeready
# Explicit dedicated project identity for setup without a management token.
SUPABASE_PROJECT_REF=
# Local setup only; neither database credentials nor management tokens are deployed.
SUPABASE_DB_URL=
DEMO_PASSWORD=
SESSION_SECRET=
MCP_SECRET=
EXECUTOR_SECRET=
APP_URL=http://localhost:3000
MAKE_BUDGET_USD=50
# Optional management token when not using a direct database connection.
SUPABASE_ACCESS_TOKEN=
